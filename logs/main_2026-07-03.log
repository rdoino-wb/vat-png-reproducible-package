. *===============================================================================
. * 3. Program: panel (a) bars and panel (b) deviations
. *===============================================================================
. global rfp   = `r_formal_pool'

. global PT_UF = `pt_uf'

. global PT_UI = `pt_ui'

. global PT_RF = `pt_rf'

. global PT_RI = `pt_ri'

. 
. capture program drop fig5_calc

. program define fig5_calc, rclass
  1.     * weighted-mean exempt expenditure per quintile, by cell (no collapse/preserve)
.     scalar Suf=0
  2.     scalar Sui=0
  3.     scalar Srf=0
  4.     scalar Sri=0
  5.     forvalues q=1/5 {
  6.         quietly summ exempt [aw=w] if quintile==`q', meanonly
  7.         scalar mE`q'=r(mean)
  8.         quietly summ exp_uf [aw=w] if quintile==`q', meanonly
  9.         scalar mUF`q'=r(mean)
 10.         quietly summ exp_ui [aw=w] if quintile==`q', meanonly
 11.         scalar mUI`q'=r(mean)
 12.         quietly summ exp_rf [aw=w] if quintile==`q', meanonly
 13.         scalar mRF`q'=r(mean)
 14.         quietly summ exp_ri [aw=w] if quintile==`q', meanonly
 15.         scalar mRI`q'=r(mean)
 16.         scalar Suf=Suf+mUF`q'
 17.         scalar Sui=Sui+mUI`q'
 18.         scalar Srf=Srf+mRF`q'
 19.         scalar Sri=Sri+mRI`q'
 20.     }
 21.     * expenditure-weighted pooled rates (blue uses pt_all; green uses pt_F, pt_I)
.     scalar pt_all=(Suf*$PT_UF+Sui*$PT_UI+Srf*$PT_RF+Sri*$PT_RI)/(Suf+Sui+Srf+Sri)
 22.     scalar pt_F  =(Suf*$PT_UF+Srf*$PT_RF)/(Suf+Srf)
 23.     scalar pt_I  =(Sui*$PT_UI+Sri*$PT_RI)/(Sui+Sri)
 24.     * benefits by quintile + totals
.     scalar TF=0
 25.     scalar TC=0
 26.     scalar TG=0
 27.     forvalues q=1/5 {
 28.         scalar bF`q'=mUF`q'*$PT_UF+mUI`q'*$PT_UI+mRF`q'*$PT_RF+mRI`q'*$PT_RI   // red, all-store
 29.         scalar bC`q'=mE`q'*pt_all                                              // blue
 30.         scalar bG`q'=(mUF`q'+mRF`q')*pt_F+(mUI`q'+mRI`q')*pt_I                 // green
 31.         scalar TF=TF+bF`q'
 32.         scalar TC=TC+bC`q'
 33.         scalar TG=TG+bG`q'
 34.     }
 35.     forvalues q=1/5 {
 36.         * *(A)* panel (a): total = formal-store PT, distributed by total benefit bF
.         *       (for formal-store benefit only, replace bF`q' with mUF`q'*$PT_UF+mRF`q'*$PT_RF
.         *        and TF with the corresponding sum)
.         return scalar A`q'  = 100*${rfp}*bF`q'/TF
 37.         return scalar Br`q' = 100*(bF`q'/TF - 0.20)
 38.         return scalar Bb`q' = 100*(bC`q'/TC - 0.20)
 39.         return scalar Bg`q' = 100*(bG`q'/TG - 0.20)
 40.     }
