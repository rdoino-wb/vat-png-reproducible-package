  8.     if "`r'"=="g4"      local lbl "  Free textbooks"
  9.     if "`r'"=="g3"      local lbl "  Remove fuel tax"
 10.     if "`r'"=="g5"      local lbl "  Free phone credit"
 11.     if !missing(b_`r'_u) {
 12.         local u  = "${bs_`r'_u}"+" ("+string(se_`r'_u,"%4.3f")+")${s_`r'_u}"
 13.         local wt = "${bs_`r'_w}"+" ("+string(se_`r'_w,"%4.3f")+")${s_`r'_w}"
 14.     }
