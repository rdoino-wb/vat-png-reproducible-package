. *------- 3. Compute percentages ---------------------------------------------
. forvalues p = 1/6 {
  2.     qui count if first_choice  == `p'
  3.     local pct_first_`p'  = 100 * r(N) / `N'
  4.     qui count if second_choice == `p'
  5.     local pct_second_`p' = 100 * r(N) / `N'
  6. }

