Linked to April preference: N = 752

. 
. *------------------------------------------------------------------- program ----
. * subgroup ATE for one subset: stores UNWEIGHTED (_u) and WEIGHTED (_w) results
. * in scalars b_<nm>_*, se_<nm>_*, n_<nm>, stars in globals s_<nm>_*, and
. * sign-explicit coefficient strings in globals bs_<nm>_*.
. capture program drop _run

. program define _run
  1.     syntax anything [if]
  2.     local nm `anything'
  3.     quietly count `if'
  4.     scalar n_`nm' = r(N)
  5.     if r(N) < 25 {
  6.         scalar b_`nm'_u = .
  7.         scalar b_`nm'_w = .
  8.         exit
  9.     }
 10.     quietly regress support5 treat version2 `if', vce(robust)
 11.     scalar b_`nm'_u  = _b[treat]
 12.     scalar se_`nm'_u = _se[treat]
 13.     local pu = 2*ttail(e(df_r), abs(_b[treat]/_se[treat]))
 14.     global s_`nm'_u  = cond(`pu'<.01,"***",cond(`pu'<.05,"**",cond(`pu'<.1,"*","")))
 15.     global bs_`nm'_u = cond(b_`nm'_u>=0,"+","") + string(b_`nm'_u,"%5.3f")
 16.     quietly regress support5 treat version2 [pw=w] `if', vce(robust)
 17.     scalar b_`nm'_w  = _b[treat]
 18.     scalar se_`nm'_w = _se[treat]
 19.     local pw = 2*ttail(e(df_r), abs(_b[treat]/_se[treat]))
 20.     global s_`nm'_w  = cond(`pw'<.01,"***",cond(`pw'<.05,"**",cond(`pw'<.1,"*","")))
 21.     global bs_`nm'_w = cond(b_`nm'_w>=0,"+","") + string(b_`nm'_w,"%5.3f")
 22. end

. 
. * interaction (treat x moderator): stores _u and _w coefficients/SE/p
. capture program drop _int

. program define _int
  1.     args nm modvar
  2.     quietly regress support5 i.treat##i.`modvar' version2 if !missing(apr_best), vce(robust)
  3.     scalar b_`nm'_u  = _b[1.treat#1.`modvar']
  4.     scalar se_`nm'_u = _se[1.treat#1.`modvar']
  5.     scalar p_`nm'_u  = 2*ttail(e(df_r), abs(b_`nm'_u/se_`nm'_u))
  6.     global s_`nm'_u  = cond(p_`nm'_u<.01,"***",cond(p_`nm'_u<.05,"**",cond(p_`nm'_u<.1,"*","")))
  7.     global bs_`nm'_u = cond(b_`nm'_u>=0,"+","") + string(b_`nm'_u,"%5.3f")
  8.     quietly regress support5 i.treat##i.`modvar' version2 [pw=w] if !missing(apr_best), vce(robust)
  9.     scalar b_`nm'_w  = _b[1.treat#1.`modvar']
 10.     scalar se_`nm'_w = _se[1.treat#1.`modvar']
 11.     scalar p_`nm'_w  = 2*ttail(e(df_r), abs(b_`nm'_w/se_`nm'_w))
 12.     global s_`nm'_w  = cond(p_`nm'_w<.01,"***",cond(p_`nm'_w<.05,"**",cond(p_`nm'_w<.1,"*","")))
 13.     global bs_`nm'_w = cond(b_`nm'_w>=0,"+","") + string(b_`nm'_w,"%5.3f")
 14. end

. 
. *----------------------------------------------------------------- estimates ----
. _run overall

. _run food  if food==1

. _run other if food==0 & !missing(apr_best)

. forvalues k = 1/6 {
  2.     _run g`k' if apr_best==`k'
  3. }

. _int iF food

. _int iC cash

. 
. * joint test across the six policy groups (base = remove food tax)
. quietly regress support5 i.treat##ib2.apr_best version2 if !missing(apr_best), vce(robust)

. quietly testparm i.treat#i.apr_best

. scalar pJ_u = r(p)

. quietly regress support5 i.treat##ib2.apr_best version2 [pw=w] if !missing(apr_best), vce(robust)

. quietly testparm i.treat#i.apr_best

. scalar pJ_w = r(p)

. 
. *------------------------------------------------------------------- display ----
. di as txt _n "{hline 78}"

