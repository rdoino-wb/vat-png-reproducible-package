. do "${dir_do}/1_data_prep/05_build_store_prices.do" // -> Final/store_collection: POM_Prices_Long_Clean.dta/.csv

. /*==============================================================================
>  05_build_store_prices.do
>  VAT exemption pass-through and incidence (Papua New Guinea) — data preparation
> 
>  PURPOSE : Extract Port Moresby supermarket price data from a multi-sheet Excel
>            workbook, match to store GPS coordinates, parse quantities, assign
>            item codes and treatment groups, and build a clean long dataset.
>  INPUTS  : ${raw_stores}/POM PRICE COLLECTION.xlsx (multi-sheet: gps_coordinates
>            plus one sheet per store)
>  OUTPUTS : ${final_stores}/POM_Prices_Long_Clean.dta
>            ${final_stores}/POM_Prices_Long_Clean.csv
>  DEPENDS : 01_globals.do (item/treatment value labels)
>  CALLED BY: main.do
> ==============================================================================*/
. 
. clear all

. set more off

. 
. ********************************************************************************
. * 1. SETUP
. ********************************************************************************
. 
. * Set file path
. local excel_file "${raw_stores}/POM PRICE COLLECTION.xlsx"

. 
. * SET NUMBER OF MONTHS TO EXTRACT - UPDATE THIS!
. * 3 = May, June, July
. * 4 = May, June, July, August
. * 5 = May, June, July, August, September
. * etc.
. local num_months = 6

. 
. * Check if file exists
. capture confirm file "`excel_file'"

. if _rc {
.     display as error "ERROR: Excel file not found"
.     exit 601
. }

. 
. * Create temporary file to store combined data
. tempfile combined_data

. local first_append = 1

. 
. ********************************************************************************
. * 2. EXTRACT GPS COORDINATES AND SUPERMARKET NAMES
. ********************************************************************************
. 
. import excel "`excel_file'", sheet("gps_coordinates") firstrow clear
(8 vars, 84 obs)

. keep if !missing(lat) & !missing(lng)
(0 observations deleted)

. destring lat lng, replace force
lat already numeric; no replace
lng already numeric; no replace

. keep if lat < 0 & lat > -15 & lng > 140 & lng < 160
(0 observations deleted)

. gen gps_index = _n

. 
. * Keep store_type variable (Independent vs Chain)
. capture confirm variable store_type

. if _rc == 0 {
.     * Clean and standardize store_type values
.     replace store_type = proper(trim(store_type))
(0 real changes made)
.     replace store_type = "Independent" if inlist(lower(store_type), "independent", "independant")
(0 real changes made)
.     replace store_type = "Chain" if inlist(lower(store_type), "chain")
(0 real changes made)
. }

. else {
.     gen store_type = ""
. }

. 
. keep gps_index Name Suburb lat lng store_type

. tempfile gps_data

. save `gps_data', replace
(file /var/folders/0f/3kj03fg14mv73c8syxhy8ykm0000gp/T//S_88812.000002 not found)
file /var/folders/0f/3kj03fg14mv73c8syxhy8ykm0000gp/T//S_88812.000002 saved as .dta format

. 
. ********************************************************************************
. * 3. DEFINE SHEET NAMES
. ********************************************************************************
. 
. local sheet_names `" " SNS Down Town" "Range View" "RH VC" "Eliseo Supermarket Waigani" "Waterfront" "Rainbow Stop and Shop " "Boroko Foodworld" "Tango 
> Tokarara" "1Stop village Shopping Mall" "Stop N Shop Badili" "Meat Haus (Waigani Drive) Port " "SNS Airways" "K Mart Supermarket" "PINGAN Trading " "TAN
> GO (Boroko)" "Kwik Mart Tokarara" "Bro and Sis (TNZ Butchery and W" "Waigani Wholesale " "Bhuiya Waigani" "Eliseo Rainbow" "papindo Gerehu " "RH Gordons
>  " "Navana Holdings" "Desh Besh Gordons" "Eliseo Boroko" "SNS Waigani Central" "SNS Boroko" "SVS 4mile" "Keme Trading #3" "M&S Trading " "Desh Besh Kons
> " "Thomand" "Mountain friend" "Bulk traders" "Rainbow Cash and Carry (Chinese" "Byron" "Jmart" "SNS 8 Mile" "9 Mile Plaza" "9 Mile Elesio " "Elesio Mosi
> n Plaza " "Wan Mart" "Amart " "Rephen supermarket " "Honyu" "WaDAwADA supermarket " "Manu cash and carry" "Alhamdulillah investment manu" "IFRA" "Shorna
>  Vadavada Taurama" "En Dian Enterprise Taurama " "ASDA Enterprises " "Super City Taurama" "No name (Across from Jannat2)" "Jannat2 (Taurama)" "Rahana Wh
> olesale Morata" "Ekra Enterprise #3 Morata " "Ekra #7 Morata" "Best Gear. Gordons " "Central Supermarket Gordon " "Skel Wan Supermarket Gordons" "Eliseo
>  Wholesale Gordons " "Gordons Wholesale " "Jade Island Gordons" "Plazawan Shopping Centre Gordon" "Eliseo Erima" "Bhuiya Erima" "Supreme Investment 6 mi
> le" "Azmir Cash and Carry" "Happy Supermarket " "Xushang Supermarket 6mile" "Goodlink Wholesale and Supermar" "Shopsmart manu" "Kwik Mart Manu" "RH Kwik
>  Mart Rainbow" "Ivy Waikele" "Ekra Waikele " "Best Price Gerehu " "Badili Mart" "Wayback Supermarket Hanuabada " "New Star Hanuabada" "Maxim Trading Sab
> ama" "Unity Supermarket Sabama" "Shop and save Tokarara" "'

. 
. ********************************************************************************
. * 4. PROCESS DATA SHEETS
. ********************************************************************************
. 
. local sheet_counter = 0

. 
. foreach sheet_name of local sheet_names {
  2.     
.     local sheet_counter = `sheet_counter' + 1
  3.     
.     preserve
  4.     use `gps_data', clear
  5.     qui levelsof Name if gps_index == `sheet_counter', local(gps_name) clean
  6.     restore
  7.     
.     if "`gps_name'" == "" {
  8.         local gps_name "`sheet_name'"
  9.     }
 10.     
.     capture {
 11.         quietly import excel "`excel_file'", sheet("`sheet_name'") cellrange(A1) clear allstring
 12.     }
 13.     
.     if _rc != 0 {
 14.         display as error "ERROR: Sheet `sheet_name' not found"
 15.         continue
 16.     }
 17.     
.     if _N < 5 {
 18.         continue
 19.     }
 20.     
.     * Get enumerator name from row 2
.     local enumerator "Not specified"
 21.     if _N >= 2 & !missing(A[2]) & A[2] != "" {
 22.         local enumerator = A[2]
 23.     }
 24.     
.     * Extract month names from row 3 for proper labeling
.     forvalues m = 1/`num_months' {
 25.         local col_num = 3 + (`m' * 2) - 1  // D=4, F=6, H=8, J=10, etc.
 26.         
.         * Get column letter
.         if `col_num' <= 26 {
 27.             local col_letter = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", `col_num', 1)
 28.         }
 29.         else {
 30.             local first_letter = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", floor((`col_num'-1)/26), 1)
 31.             local second_letter = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", mod(`col_num'-1, 26) + 1, 1)
 32.             local col_letter "`first_letter'`second_letter'"
 33.         }
 34.         
.         * Get month name from row 3
.         capture confirm variable `col_letter'
 35.         if _rc == 0 & _N >= 3 {
 36.             local month_name_`m' = `col_letter'[3]
 37.             if missing("`month_name_`m''") | "`month_name_`m''" == "" {
 38.                 local month_name_`m' "Month`m'"
 39.             }
 40.         }
 41.         else {
 42.             local month_name_`m' "Month`m'"
 43.         }
 44.     }
 45.     
.     keep if _n >= 5
 46.     
.     * Build column list to keep: A, B, C, then Price/Quantity pairs
.     local keep_cols "A B C"
 47.     forvalues m = 1/`num_months' {
 48.         local price_col_num = 3 + (`m' * 2) - 1  // D, F, H, J, ...
 49.         local qty_col_num = 3 + (`m' * 2)        // E, G, I, K, ...
 50.         
.         * Convert to column letters
.         if `price_col_num' <= 26 {
 51.             local price_col = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", `price_col_num', 1)
 52.         }
 53.         else {
 54.             local first = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", floor((`price_col_num'-1)/26), 1)
 55.             local second = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", mod(`price_col_num'-1, 26) + 1, 1)
 56.             local price_col "`first'`second'"
 57.         }
 58.         
.         if `qty_col_num' <= 26 {
 59.             local qty_col = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", `qty_col_num', 1)
 60.         }
 61.         else {
 62.             local first = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", floor((`qty_col_num'-1)/26), 1)
 63.             local second = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", mod(`qty_col_num'-1, 26) + 1, 1)
 64.             local qty_col "`first'`second'"
 65.         }
 66.         
.         * Check if columns exist before adding to keep list
.         capture confirm variable `price_col'
 67.         if _rc == 0 {
 68.             local keep_cols "`keep_cols' `price_col'"
 69.         }
 70.         capture confirm variable `qty_col'
 71.         if _rc == 0 {
 72.             local keep_cols "`keep_cols' `qty_col'"
 73.         }
 74.     }
 75.     
.     keep `keep_cols'
 76.     
.     * Rename columns - keep column C but we won't use it later
.     rename A Item
 77.     rename B Brand  
 78.     capture rename C StandardAmount_unused
 79.     
.     * Rename Price and Quantity columns for each month
.     forvalues m = 1/`num_months' {
 80.         local price_col_num = 3 + (`m' * 2) - 1
 81.         local qty_col_num = 3 + (`m' * 2)
 82.         
.         if `price_col_num' <= 26 {
 83.             local price_col = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", `price_col_num', 1)
 84.         }
 85.         else {
 86.             local first = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", floor((`price_col_num'-1)/26), 1)
 87.             local second = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", mod(`price_col_num'-1, 26) + 1, 1)
 88.             local price_col "`first'`second'"
 89.         }
 90.         
.         if `qty_col_num' <= 26 {
 91.             local qty_col = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", `qty_col_num', 1)
 92.         }
 93.         else {
 94.             local first = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", floor((`qty_col_num'-1)/26), 1)
 95.             local second = substr("ABCDEFGHIJKLMNOPQRSTUVWXYZ", mod(`qty_col_num'-1, 26) + 1, 1)
 96.             local qty_col "`first'`second'"
 97.         }
 98.         
.         capture confirm variable `price_col'
 99.         if _rc == 0 {
100.             rename `price_col' Price_`month_name_`m''
101.         }
102.         
.         capture confirm variable `qty_col'
103.         if _rc == 0 {
104.             rename `qty_col' Quantity_`month_name_`m''
105.         }
106.     }
107.     
.     * Remove rows with missing Item
.     drop if missing(Item) | Item == ""
108.     
.     * Create long format
.     gen sheet_index = `sheet_counter'
109.     gen Supermarket = "`gps_name'"
110.     gen Sheet_Tab_Name = "`sheet_name'"
111.     gen Enumerator = "`enumerator'"
112.     
.     * Reshape to long format
.     local price_vars ""
113.     local qty_vars ""
114.     forvalues m = 1/`num_months' {
115.         local price_vars "`price_vars' Price_`month_name_`m''"
116.         local qty_vars "`qty_vars' Quantity_`month_name_`m''"
117.     }
118.     
.     reshape long Price_ Quantity_, i(Item Brand sheet_index) j(Month) string
119.     rename Price_ Price
120.     rename Quantity_ old_quantity
121.     
.     * Format month to title case (first letter uppercase)
.     replace Month = upper(substr(Month, 1, 1)) + lower(substr(Month, 2, .))
122.     
.     * Drop unused standard amount column
.     capture drop StandardAmount_unused
123.     
.     * Merge GPS data
.     gen gps_index = sheet_index
124.     merge m:1 gps_index using `gps_data', keep(master match) nogenerate
125.     drop gps_index
126.     
.     if `first_append' == 1 {
127.         save `combined_data', replace
128.         local first_append = 0
129.     }
130.     else {
131.         append using `combined_data'
132.         save `combined_data', replace
133.     }
134. }
