  8.     forvalues k = 1/5 {
  9.         local et = `k'
 10.         local lab = cond(`k'==1, "Jun 25", cond(`k'==2, "Jul 25", cond(`k'==3, "Aug 25", cond(`k'==4, "Sep 25", "Oct 25"))))
 11.         local cname "`k'.event_time_shift#1.treated"
 12.         local b = _b[`cname']
 13.         local s = _se[`cname']
 14.         local lo = `b' - `tcrit'*`s'
 15.         local hi = `b' + `tcrit'*`s'
 16.         post A (`g') ("`glabel'") (`et') ("`lab'") (`b') (`s') (`lo') (`hi') (0)
 17.     }
 18.     quietly reghdfe r_price treatedpost, absorb(sheet_index month_year item_code) vce(cluster item_code)
 19.     local tcrit = invttail(e(df_r), 0.025)
 20.     local b = _b[treatedpost]
 21.     local s = _se[treatedpost]
 22.     local lo = `b' - `tcrit'*`s'
 23.     local hi = `b' + `tcrit'*`s'
 24.     post A (`g') ("`glabel'") (6.4) ("Post Avg.") (`b') (`s') (`lo') (`hi') (1)
 25. }
