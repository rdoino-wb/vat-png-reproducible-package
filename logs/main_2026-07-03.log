. ********************************************************************************
. * 2b. EVENT STUDY (panel b): monthly DiD coefficients by source, in p.p.
. ********************************************************************************
. 
. tempname pf

. tempfile coefs

. postfile `pf' byte srcid int event_time double b double lo95 double hi95 using `coefs', replace
(file /var/folders/0f/3kj03fg14mv73c8syxhy8ykm0000gp/T//S_88812.000004 not found)

. 
. foreach s in 1 2 3 {
  2.     preserve
  3.     keep if srcid == `s'
  4.     quietly summarize event_time
  5.     local lo = r(min)
  6.     gen int et_shift = event_time - `lo'
  7.     local base = -1 - `lo'                       // baseline = May 2025 (event_time -1)
  8.     if `s' == 3 {
  9.         quietly reghdfe y ib`base'.et_shift##i.tg, absorb(idnum storeid stata_month) vce(cluster idnum)
 10.     }
 11.     else {
 12.         quietly reghdfe y ib`base'.et_shift##i.tg, absorb(idnum stata_month) vce(cluster idnum)
 13.     }
 14.     levelsof et_shift, local(ets)
 15.     foreach e of local ets {
 16.         local et = `e' + `lo'
 17.         if `e' == `base' {
 18.             post `pf' (`s') (`et') (0) (0) (0)
 19.         }
 20.         else {
 21.             local cn "`e'.et_shift#1.tg"
 22.             capture local bb = _b[`cn']
 23.             if _rc continue
 24.             local ss = _se[`cn']
 25.             * scale to percentage points (x100): full pass-through = -9.1 p.p.
.             post `pf' (`s') (`et') (100*`bb') (100*(`bb'-1.96*`ss')) (100*(`bb'+1.96*`ss'))
 26.         }
 27.     }
 28. 
.     * --- joint pre-trends Wald test: leads strictly before the May 2025 reference ---
.     local pretest ""
 29.     foreach e of local ets {
 30.         local et = `e' + `lo'
 31.         if `e' != `base' & `et' <= -2 {
 32.             local pretest "`pretest' `e'.et_shift#1.tg"
 33.         }
 34.     }
 35.     if "`pretest'" != "" {
 36.         quietly test `pretest'
 37.         local k  = r(df)
 38.         local FF = r(F)
 39.         local pp = r(p)
 40.         di as txt _n "{hline 70}"
 41.         di as txt "Joint pre-trends Wald test, `lab`s'' data (`k' leads):"
 42.         di as res "   F = " %6.3f `FF' "   p = " %5.3f `pp'
 43.     }
 44. 
.     * --- post-reform average pass-through: June 2025 onward (event_time >= 0), p.p. ---
.     local postsum = 0
 45.     local npost   = 0
 46.     foreach e of local ets {
 47.         local et = `e' + `lo'
 48.         if `et' >= 0 {
 49.             capture local bpost = _b[`e'.et_shift#1.tg]
 50.             if !_rc {
 51.                 local postsum = `postsum' + `bpost'
 52.                 local ++npost
 53.             }
 54.         }
 55.     }
 56.     if `npost' > 0 {
 57.         di as res "   post-reform average pass-through = " %5.1f `=100*`postsum'/`npost'' " p.p.  (over `npost' months)"
 58.         di as txt "{hline 70}"
 59.     }
 60. 
.     restore
 61. }
