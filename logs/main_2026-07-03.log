. * Store census
. do "${dir_do}/3_analysis/figsA36_A38_event_study_stores.do"   // Figs A36 (store type), A38 (luxury)

. /*==============================================================================
>  figsA36_A38_event_study_stores.do
>  VAT exemption pass-through and incidence (Papua New Guinea) — analysis
> 
>  PURPOSE : Store-price event studies by luxury vs basic goods (Figure A38) and
>            by store type, chain vs independent (Figure A36).
>  INPUTS  : ${final_stores}/POM_Prices_Long_Clean.dta; globals ${dir_graphs},
>            ${dir_tables}, colors ${my_blue}, ${my_red}
>  OUTPUTS : ${dir_graphs}/figure_a38.png, figure_a36.png;
>            ${dir_tables}/regression_luxury.dta, regression_storetype.dta (scratch)
>  DEPENDS : ${final_stores}/POM_Prices_Long_Clean.dta must exist
>  CALLED BY: main.do
> ==============================================================================*/
. 
. local num_months = 6

. 
. *------------------------------------------------------------------------------*
. * HETEROGENEITY BY LUXURY GOODS - SEPARATE REGRESSIONS
. *------------------------------------------------------------------------------*
. 
. 
. foreach group in all { // narrowed to paper spec: A38 uses group=all
  2. foreach sample_type in balanced { // narrowed to paper spec: balanced panel
  3. 
. * Create dataset to store regression results
. cap erase "$dir_tables/regression_luxury.dta"
  4. preserve 
  5.         clear
  6.         set obs 1
  7.         gen luxury_type = "garbage" 
  8.         save "$dir_tables/regression_luxury.dta", replace
  9. restore  
 10. 
. foreach luxury_val in 0 1 {
 11.         if `luxury_val' == 0 {
 12.                 local luxury_name "basic"
 13.         }
 14.         else {
 15.                 local luxury_name "luxury"
 16.         }
 17.         
.         use "${final_stores}/POM_Prices_Long_Clean.dta", clear
 18.         
.         * FILTER: Keep only this luxury category
.         keep if luxury == `luxury_val'
 19.         
.         * Create price per unit
.         gen price_per_unit = Price / quantity
 20.         drop if missing(price_per_unit) | price_per_unit <= 0
 21.         
.         * Convert month to numeric
.         gen month_num = .
 22.         replace month_num = 1 if Month == "May"
 23.         replace month_num = 2 if Month == "June"
 24.         replace month_num = 3 if Month == "July"
 25.         replace month_num = 4 if Month == "August"
 26.         replace month_num = 5 if Month == "September"
 27.         replace month_num = 6 if Month == "October"
 28.         
.         keep if month_num <= `num_months' & !missing(month_num)
 29.         gen month_year = month_num
 30.         
.         * Winsorize
.         bysort item_code: egen p5 = pctile(price_per_unit), p(5)
 31.         bysort item_code: egen p95 = pctile(price_per_unit), p(95)
 32.         gen price_w5 = price_per_unit
 33.         replace price_w5 = p5 if price_per_unit < p5 & !missing(p5)
 34.         replace price_w5 = p95 if price_per_unit > p95 & !missing(p95)
 35.         drop p5 p95
 36.         
.         * Treatment variables
.         drop treat
 37.         gen treat = treat_`group'
 38.         rename treat treated
 39.         keep if treated != .
 40.         
.         gen post = (month_num >= 2 & month_num != .)
 41.         gen treatedpost = (treated == 1 & post == 1)
 42.         
.         * Relative prices
.         bysort item_code sheet_index: egen price_may25 = mean(cond(month_num == 1, price_w5, .))
 43.         bysort item_code: egen price_may25_overall = mean(cond(month_num == 1, price_w5, .))
 44.         replace price_may25 = price_may25_overall if missing(price_may25)
 45.         drop price_may25_overall
 46.         gen r_price = price_w5 / price_may25
 47.         drop if missing(r_price)
 48.         
.         * Balance panel if needed
.         if "`sample_type'" == "balanced" {
 49.                 egen store_product = group(sheet_index item_code)
 50.                 bysort store_product: gen n_months_obs = _N
 51.                 keep if n_months_obs == `num_months'
 52.                 drop n_months_obs store_product
 53.         }
 54.         
.         * Event time
.         gen rel_time = month_num - 2
 55.         gen event_time = rel_time
 56.         local lower = -1
 57.         gen event_time_shift = event_time - `lower'
 58.         local baseline = 0
 59.         local upper = `num_months' - 2
 60.         
.         * DID with CI calculation
.         reghdfe r_price treatedpost, absorb(sheet_index month_year item_code) vce(cluster item_code)
 61.                 local DIDcoef: di %-4.3f _b[treatedpost]
 62.                 local DIDse: di %-4.3f _se[treatedpost]
 63.                 local DIDp = (2 * ttail(e(df_r), abs(_b[treatedpost] / _se[treatedpost])))
 64.                 * Calculate 95% CI for pooled estimate
.                 local t_crit = invttail(e(df_r), 0.025)
 65.                 local DID_ci_lower = _b[treatedpost] - `t_crit' * _se[treatedpost]
 66.                 local DID_ci_upper = _b[treatedpost] + `t_crit' * _se[treatedpost]
 67.         
.         * Event study - SIMPLE TWO-WAY INTERACTION
.         reghdfe r_price ib`baseline'.event_time_shift##i.treated, ///
>                 absorb(sheet_index month_year item_code) vce(cluster item_code)
 68.         
.         regsave using "$dir_tables/regression_luxury.dta", ci pval level(95) append ///
>                 addlabel(DIDcoef, `DIDcoef', DIDse, `DIDse', DIDp, `DIDp', ///
>                          DID_ci_lower, `DID_ci_lower', DID_ci_upper, `DID_ci_upper', ///
>                          luxury_type, "`luxury_name'")
 69. }
 70. 
. * Load and prepare graph data
. use "$dir_tables/regression_luxury.dta", clear
 71. drop if luxury_type == "garbage"
 72. 
. keep if regexm(var, "^[0-9]+\.event_time_shift#1\.treated$")
 73. gen event_time_shift_num = real(regexs(1)) if regexm(var, "^([0-9]+)\.event_time_shift#1\.treated$")
 74. 
. * Get DID CIs for each luxury type
. qui sum DID_ci_lower if luxury_type == "basic"
 75. local did_ci_lower_basic = r(mean)
 76. qui sum DID_ci_upper if luxury_type == "basic"
 77. local did_ci_upper_basic = r(mean)
 78. qui sum DIDcoef if luxury_type == "basic"
 79. local did_coef_basic = r(mean)
 80. 
. qui sum DID_ci_lower if luxury_type == "luxury"
 81. local did_ci_lower_luxury = r(mean)
 82. qui sum DID_ci_upper if luxury_type == "luxury"
 83. local did_ci_upper_luxury = r(mean)
 84. qui sum DIDcoef if luxury_type == "luxury"
 85. local did_coef_luxury = r(mean)
 86. 
. * Add baseline for each luxury type
. foreach luxury_name in "basic" "luxury" {
 87.         local N = _N + 1
 88.         set obs `N'
 89.         replace var = "0.event_time_shift#1.treated" in `N'
 90.         replace event_time_shift_num = 0 in `N'
 91.         replace coef = 0 in `N'
 92.         replace ci_lower = 0 in `N'
 93.         replace ci_upper = 0 in `N'
 94.         replace luxury_type = "`luxury_name'" in `N'
 95. }
 96. 
. gen event_time = event_time_shift_num + `lower'
 97. 
. * Add pooled post-reform points
. local pooled_pos = `upper' + 1.5
 98. 
. * Basic pooled point
. local N = _N + 1
 99. set obs `N'
100. replace var = "pooled_post" in `N'
101. replace event_time = `pooled_pos' in `N'
102. replace coef = `did_coef_basic' in `N'
103. replace ci_lower = `did_ci_lower_basic' in `N'
104. replace ci_upper = `did_ci_upper_basic' in `N'
105. replace luxury_type = "basic" in `N'
106. 
. * Luxury pooled point
. local N = _N + 1
107. set obs `N'
108. replace var = "pooled_post" in `N'
109. replace event_time = `pooled_pos' in `N'
110. replace coef = `did_coef_luxury' in `N'
111. replace ci_lower = `did_ci_lower_luxury' in `N'
112. replace ci_upper = `did_ci_upper_luxury' in `N'
113. replace luxury_type = "luxury" in `N'
114. 
. * Flag for pooled points
. gen is_pooled = (var == "pooled_post")
115. 
. * Create jittered x-axis for visibility
. gen event_time_aux = event_time
116. replace event_time_aux = event_time - 0.1 if luxury_type == "basic"
117. replace event_time_aux = event_time + 0.1 if luxury_type == "luxury"
118. 
. sort luxury_type event_time
119. 
. label def event_time_lab -1 "May 25" 0 "Jun 25" 1 "Jul 25" 2 "Aug 25" 3 "Sep 25" 4 "Oct 25"
120. label val event_time event_time_lab
121. 
. local text_pos = floor((`upper' + 0) / 2)
122. if `text_pos' < 1 local text_pos = 0.4
123. local xline_pos = `upper' + 0.75
124. 
. * Graph with pooled points
. twoway scatter coef event_time_aux if luxury_type == "basic" & !is_pooled, ///
>            connect(l) mlcolor("$my_blue") mfcolor("$my_blue*0.5") lcolor("$my_blue") msymbol(O) ///
>         || rcap ci_lower ci_upper event_time_aux if luxury_type == "basic" & !is_pooled, color("$my_blue*0.5") lwidth(medium) ///
>         || scatter coef event_time_aux if luxury_type == "luxury" & !is_pooled, ///
>            connect(l) mlcolor("$my_red") mfcolor("$my_red*0.5") lcolor("$my_red") msymbol(T) ///
>         || rcap ci_lower ci_upper event_time_aux if luxury_type == "luxury" & !is_pooled, color("$my_red*0.5") lwidth(medium) ///
>         || scatter coef event_time_aux if luxury_type == "basic" & is_pooled, ///
>            mlcolor("$my_blue") mfcolor("$my_blue*0.5") msymbol(O) ///
>         || rcap ci_lower ci_upper event_time_aux if luxury_type == "basic" & is_pooled, color("$my_blue") lwidth(medthick) ///
>         || scatter coef event_time_aux if luxury_type == "luxury" & is_pooled, ///
>            mlcolor("$my_red") mfcolor("$my_red*0.5") msymbol(T) ///
>         || rcap ci_lower ci_upper event_time_aux if luxury_type == "luxury" & is_pooled, color("$my_red") lwidth(medthick) ///
>         , ///
>         xline(-0.5, lcolor(gs6) lpattern(dash)) ///
