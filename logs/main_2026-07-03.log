. foreach c of local exempt {
  2.     gen double sp = s4q5`c'
  3.     replace    sp = 0 if missing(sp) | sp < 0
  4.     replace exempt_formal   = exempt_formal   + sp if s4q2`c'==2
  5.     replace exempt_informal = exempt_informal + sp if s4q2`c'!=2
  6.     drop sp
  7. }
