. *------------------------------------------------------------------------------*
. * Product prices 
. *------------------------------------------------------------------------------*
. 
. display "Creating product prices with winsorization..."
Creating product prices with winsorization...

. 
. /* We will use two main set of variables to calculate prices:
>    - units purchased (s4q3*)
>    - money spent on quantity purchased (s4q5*) */
. 
. * Recode -99 values, which correspond to "don't know/remember"  
. quietly recode s4q3* (-99 = .)

. quietly recode s4q5* (-99 = .)

. 
. * Create prices varying the winsorizing levels
. 
. foreach win_level in 1 5 {
  2.         
.         display "  Winsorizing level `win_level'%..."
  3.                 
.         local products 101 102 103 104 105 107 108 110 111 114 115 116 124 125 126 127 128 129 130 131 132 133 134 135
  4. 
.         if "`win_level'" == "1" {
  5.                 local top 99
  6.                 local bottom 1
  7.         }
  8.         if "`win_level'" == "5" {
  9.                 local top 95
 10.                 local bottom 5
 11.         }
 12.         
.         * Build the variable lists once, then winsorize in batched calls. winsor2
.         * treats each variable independently, so batching matches one call per variable.
.         local exp_vars ""
 13.         local qty_vars ""
 14.         foreach q in `products' {
 15.                 local exp_vars `exp_vars' s4q5`q'
 16.                 local qty_vars `qty_vars' s4q3`q'
 17.         }
 18.         quietly winsor2 `exp_vars', cuts(`bottom' `top') suffix(_w`win_level')
 19.         quietly winsor2 `qty_vars', cuts(`bottom' `top') suffix(_w`win_level')
 20. 
.         local price_vars ""
 21.         foreach q in `products' {
 22.                 quietly gen price_`q'_w`win_level' = s4q5`q'_w`win_level' / s4q3`q'_w`win_level'
 23.                 local price_vars `price_vars' price_`q'_w`win_level'
 24.         }
 25.         quietly winsor2 `price_vars', cuts(`bottom' `top') replace
 26.         
.         display "    All 24 products processed for level `win_level'%"
 27. 
.         * Step 3: Express prices in terms of relevant quantities for each product
.         quietly replace price_101_w`win_level' = price_101_w`win_level' * 1000
 28.         quietly replace price_104_w`win_level' = price_104_w`win_level' * 100
 29.         quietly replace price_107_w`win_level' = price_107_w`win_level' * 100
 30.         quietly replace price_114_w`win_level' = price_114_w`win_level' * 100
 31. }
  Winsorizing level 1%...
    All 24 products processed for level 1%
  Winsorizing level 5%...
    All 24 products processed for level 5%

