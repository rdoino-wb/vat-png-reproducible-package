. local j = 1

. forvalues q = 41/55 {
  2.     if `q' == 52 {
  3.         post hdl_food ("Comparable (28)") (`q') (0) (0) (0) (0)
  4.     }
  5.     else {
  6.         local coef = _b[treat_q`q']
  7.         local se   = _se[treat_q`q']
  8.         local lo   = `coef' - 1.96 * `se'
  9.         local hi   = `coef' + 1.96 * `se'
 10.         post hdl_food ("Comparable (28)") (`q') (`coef') (`se') (`lo') (`hi')
 11.         local j = `j' + 1
 12.     }
 13. }

. postclose hdl_food

. restore

