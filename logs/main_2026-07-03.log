. *------------------------------------------------------------------------------*
. * HETEROGENEITY BY STORE TYPE - SEPARATE REGRESSIONS
. *------------------------------------------------------------------------------*
. 
. foreach group in all { // narrowed to paper spec: A36 uses group=all
  2. foreach sample_type in balanced { // narrowed to paper spec: balanced panel
  3. 
. cap erase "$dir_tables/regression_storetype.dta"
  4. preserve 
  5.         clear
  6.         set obs 1
  7.         gen store_category = "garbage" 
  8.         save "$dir_tables/regression_storetype.dta", replace
  9. restore  
 10. 
. foreach store in Independent Chain {
 11.         
.         use "${final_stores}/POM_Prices_Long_Clean.dta", clear
 12.         
.         * FILTER: Keep only this store type
.         keep if store_type == "`store'"
 13.         
.         * Create price per unit
.         gen price_per_unit = Price / quantity
 14.         drop if missing(price_per_unit) | price_per_unit <= 0
 15.         
.         * Convert month to numeric
.         gen month_num = .
 16.         replace month_num = 1 if Month == "May"
 17.         replace month_num = 2 if Month == "June"
 18.         replace month_num = 3 if Month == "July"
 19.         replace month_num = 4 if Month == "August"
 20.         replace month_num = 5 if Month == "September"
 21.         replace month_num = 6 if Month == "October"
 22.         
.         keep if month_num <= `num_months' & !missing(month_num)
 23.         gen month_year = month_num
 24.         
.         * Winsorize
.         bysort item_code: egen p5 = pctile(price_per_unit), p(5)
 25.         bysort item_code: egen p95 = pctile(price_per_unit), p(95)
 26.         gen price_w5 = price_per_unit
 27.         replace price_w5 = p5 if price_per_unit < p5 & !missing(p5)
 28.         replace price_w5 = p95 if price_per_unit > p95 & !missing(p95)
 29.         drop p5 p95
 30.         
.         * Treatment variables
.         drop treat
 31.         gen treat = treat_`group'
 32.         rename treat treated
 33.         keep if treated != .
 34.         
.         gen post = (month_num >= 2 & month_num != .)
 35.         gen treatedpost = (treated == 1 & post == 1)
 36.         
.         * Relative prices
.         bysort item_code sheet_index: egen price_may25 = mean(cond(month_num == 1, price_w5, .))
 37.         bysort item_code: egen price_may25_overall = mean(cond(month_num == 1, price_w5, .))
 38.         replace price_may25 = price_may25_overall if missing(price_may25)
 39.         drop price_may25_overall
 40.         gen r_price = price_w5 / price_may25
 41.         drop if missing(r_price)
 42.         
.         * Balance panel if needed
.         if "`sample_type'" == "balanced" {
 43.                 egen store_product = group(sheet_index item_code)
 44.                 bysort store_product: gen n_months_obs = _N
 45.                 keep if n_months_obs == `num_months'
 46.                 drop n_months_obs store_product
 47.         }
 48.         
.         * Event time
.         gen rel_time = month_num - 2
 49.         gen event_time = rel_time
 50.         local lower = -1
 51.         gen event_time_shift = event_time - `lower'
 52.         local baseline = 0
 53.         local upper = `num_months' - 2
 54.         
.         * DID
.         reghdfe r_price treatedpost, absorb(sheet_index month_year item_code) vce(cluster item_code)
 55.                 local DIDcoef = _b[treatedpost]
 56.                 local DIDse = _se[treatedpost]
 57.                 local DIDp = (2 * ttail(e(df_r), abs(_b[treatedpost] / _se[treatedpost])))
 58.         
.         * Event study
.         reghdfe r_price ib`baseline'.event_time_shift##i.treated, ///
>                 absorb(sheet_index month_year item_code) vce(cluster item_code)
 59.         
.         regsave using "$dir_tables/regression_storetype.dta", ci pval level(95) append ///
>                 addlabel(DIDcoef, `DIDcoef', DIDse, `DIDse', DIDp, `DIDp', store_category, "`store'")
 60. }
 61. 
. * Load and prepare graph data
. use "$dir_tables/regression_storetype.dta", clear
 62. drop if store_category == "garbage"
 63. 
. * Define bounds
. local lower = -1
 64. local upper = `num_months' - 2
 65. 
. keep if regexm(var, "^[0-9]+\.event_time_shift#1\.treated$")
 66. gen event_time_shift_num = real(regexs(1)) if regexm(var, "^([0-9]+)\.event_time_shift#1\.treated$")
 67. 
. * Get DID info for each store type (calculate CI from coef and se)
. qui sum DIDcoef if store_category == "Independent"
 68. local did_coef_indep = r(mean)
 69. qui sum DIDse if store_category == "Independent"
 70. local did_se_indep = r(mean)
 71. local did_ci_lower_indep = `did_coef_indep' - 1.96 * abs(`did_se_indep')
 72. local did_ci_upper_indep = `did_coef_indep' + 1.96 * abs(`did_se_indep')
 73. 
. qui sum DIDcoef if store_category == "Chain"
 74. local did_coef_chain = r(mean)
 75. qui sum DIDse if store_category == "Chain"
 76. local did_se_chain = r(mean)
 77. local did_ci_lower_chain = `did_coef_chain' - 1.96 * abs(`did_se_chain')
 78. local did_ci_upper_chain = `did_coef_chain' + 1.96 * abs(`did_se_chain')
 79. 
. display "Independent: coef=`did_coef_indep' se=`did_se_indep'"
 80. display "Chain: coef=`did_coef_chain' se=`did_se_chain'"
 81. 
. * Add baseline for each store type
. foreach store in Independent Chain {
 82.         local N = _N + 1
 83.         set obs `N'
 84.         replace var = "0.event_time_shift#1.treated" in `N'
 85.         replace event_time_shift_num = 0 in `N'
 86.         replace coef = 0 in `N'
 87.         replace ci_lower = 0 in `N'
 88.         replace ci_upper = 0 in `N'
 89.         replace store_category = "`store'" in `N'
 90. }
 91. 
. gen event_time = event_time_shift_num + `lower'
 92. 
. * Add pooled post-reform points
. local pooled_pos = `upper' + 1.5
 93. 
. * Independent pooled point
. local N = _N + 1
 94. set obs `N'
 95. replace var = "pooled_post" in `N'
 96. replace event_time = `pooled_pos' in `N'
 97. replace coef = `did_coef_indep' in `N'
 98. replace ci_lower = `did_ci_lower_indep' in `N'
 99. replace ci_upper = `did_ci_upper_indep' in `N'
100. replace store_category = "Independent" in `N'
101. 
. * Chain pooled point
. local N = _N + 1
102. set obs `N'
103. replace var = "pooled_post" in `N'
104. replace event_time = `pooled_pos' in `N'
105. replace coef = `did_coef_chain' in `N'
106. replace ci_lower = `did_ci_lower_chain' in `N'
107. replace ci_upper = `did_ci_upper_chain' in `N'
108. replace store_category = "Chain" in `N'
109. 
. * Flag for pooled points
. gen is_pooled = (var == "pooled_post")
110. 
. * Create jittered x-axis for visibility
. gen event_time_aux = event_time
111. replace event_time_aux = event_time - 0.1 if store_category == "Independent"
112. replace event_time_aux = event_time + 0.1 if store_category == "Chain"
113. 
. sort store_category event_time
114. 
. label def event_time_lab -1 "May 25" 0 "Jun 25" 1 "Jul 25" 2 "Aug 25" 3 "Sep 25" 4 "Oct 25"
115. label val event_time event_time_lab
116. 
. local text_pos = floor((`upper' + 0) / 2)
117. if `text_pos' < 1 local text_pos = 0.4
118. local xline_pos = `upper' + 0.75
119. 
. * Graph with pooled points
. twoway scatter coef event_time_aux if store_category == "Independent" & is_pooled == 0, ///
>            connect(l) mlcolor("$my_blue") mfcolor("$my_blue*0.5") lcolor("$my_blue") msymbol(O) ///
>         || rcap ci_lower ci_upper event_time_aux if store_category == "Independent" & is_pooled == 0, color("$my_blue*0.5") lwidth(medium) ///
>         || scatter coef event_time_aux if store_category == "Chain" & is_pooled == 0, ///
>            connect(l) mlcolor("$my_red") mfcolor("$my_red*0.5") msymbol(T) lcolor("$my_red") ///
>         || rcap ci_lower ci_upper event_time_aux if store_category == "Chain" & is_pooled == 0, color("$my_red*0.5") lwidth(medium) ///
>         || scatter coef event_time_aux if store_category == "Independent" & is_pooled == 1, ///
>            mlcolor("$my_blue") mfcolor("$my_blue*0.5") msymbol(O) ///
>         || rcap ci_lower ci_upper event_time_aux if store_category == "Independent" & is_pooled == 1, color("$my_blue") lwidth(medthick) ///
>         || scatter coef event_time_aux if store_category == "Chain" & is_pooled == 1, ///
>            mlcolor("$my_red") mfcolor("$my_red*0.5") msymbol(T) ///
>         || rcap ci_lower ci_upper event_time_aux if store_category == "Chain" & is_pooled == 1, color("$my_red") lwidth(medthick) ///
>         , ///
>         xline(-0.5, lcolor(gs6) lpattern(dash)) ///
>         xline(`xline_pos', lcolor(gs6) lpattern(dot)) ///
>         yline(0, lcolor(gs6)) ///
>         yline(-0.091, lpattern(dash) lcolor(gs6)) ///
>         caption("Price effect (p.p.)", pos(11)) ///
>         xtitle("") ytitle("") ///
>         ylabel(-0.3 "-30" -0.2 "-20" -0.1 "-10" 0 "0" 0.1 "10", nogrid) yscale(range(-0.2 0.2)) ///
>         xlabel(-1 "May 25" 0 "Jun 25" 1 "Jul 25" 2 "Aug 25" 3 "Sep 25" 4 "Oct 25" `pooled_pos' "Post", ///
>                 angle(45) labsize(small) nogrid) ///
>         text(0.15 0 "VAT exemptions", box bcolor(white) lcolor(gs6) color(gs6)) ///
>         text(-0.13 `text_pos' "Full pass through {&Delta}p: -9.1 p.p.", size(small) color(gs6)) ///
>         legend(order(1 "Independent" 3 "Chain") pos(6) rows(1)) ///
>         graphregion(color(white) margin(l=2 r=3 t=1 b=0)) ///
>         plotregion(color(white))
120. 
. graph export "$dir_graphs/figure_a36.png", replace width(2400)
121. 
. }
122. }
