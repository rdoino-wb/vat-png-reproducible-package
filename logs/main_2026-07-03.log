.                 quietly replace quintile_b = 1 if avg_inc_`x' < q1b & avg_inc_`x' != .  & quintile_b == . & min_year == 20`x' 
  3.                 quietly replace quintile_b = 2 if avg_inc_`x' >= q1b & avg_inc_`x' < q2b &  quintile_b == . & min_year == 20`x' 
  4.                 quietly replace quintile_b = 3 if avg_inc_`x' >= q2b & avg_inc_`x' < q3b &  quintile_b == . & min_year == 20`x' 
  5.                 quietly replace quintile_b = 4 if avg_inc_`x' >= q3b & avg_inc_`x' < q4b &  quintile_b == . & min_year == 20`x' 
  6.                 quietly replace quintile_b = 5 if avg_inc_`x' >= q4b & avg_inc_`x' !=. &  quintile_b == . & min_year == 20`x' 
  7.         }

. 
. display "Strategy 2 complete"
Strategy 2 complete

