. *------------------------------*
. * Helper program               *
. *------------------------------*
. capture program drop _post_table_spec

. program define _post_table_spec
  1.     version 16.0
  2.     syntax, COL(integer) MODEL(string) COVERAGE(string) [URBANONLY(integer -1)]
  3. 
.     preserve
  4. 
.     if `urbanonly' == 1 keep if urban == 1
  5.     if `urbanonly' == 0 keep if urban == 0
  6. 
.     local base = ym(2025,5)
  7.     levelsof mdate, local(dates)
  8. 
.     local rhs "i.code_id i.date_id"
  9.     local post_tr ""
 10.     local post_tf ""
 11.     local post_tu ""
 12.     local post_tfu ""
 13. 
.     if "`model'" == "basic" {
 14.         foreach d of local dates {
 15.             if `d' != `base' {
 16.                 gen double tr_`d' = treatment * (mdate == `d')
 17.                 local rhs "`rhs' tr_`d'"
 18.                 if `d' > `base' local post_tr "`post_tr' tr_`d'"
 19.             }
 20.         }
 21.     }
 22.     else if "`model'" == "formal" {
 23.         gen double treat_formal = treatment * formal
 24.         local rhs "`rhs' formal treat_formal"
 25. 
.         foreach d of local dates {
 26.             if `d' != `base' {
 27.                 gen double formal_`d' = formal * (mdate == `d')
 28.                 gen double tr_`d'     = treatment * (mdate == `d')
 29.                 gen double tf_`d'     = treatment * formal * (mdate == `d')
 30.                 local rhs "`rhs' formal_`d' tr_`d' tf_`d'"
 31.                 if `d' > `base' {
 32.                     local post_tr "`post_tr' tr_`d'"
 33.                     local post_tf "`post_tf' tf_`d'"
 34.                 }
 35.             }
 36.         }
 37.     }
 38.     else if "`model'" == "urban_formal" {
 39.         gen double formal_urban = formal * urban
 40.         gen double treat_formal = treatment * formal
 41.         gen double treat_urban  = treatment * urban
 42.         gen double treat_formal_urban = treatment * formal * urban
 43. 
.         local rhs "`rhs' formal urban formal_urban treat_formal treat_urban treat_formal_urban"
 44. 
.         foreach d of local dates {
 45.             if `d' != `base' {
 46.                 gen double formal_`d'       = formal * (mdate == `d')
 47.                 gen double urban_`d'        = urban * (mdate == `d')
 48.                 gen double formalurban_`d'  = formal * urban * (mdate == `d')
 49.                 gen double tr_`d'           = treatment * (mdate == `d')
 50.                 gen double tf_`d'           = treatment * formal * (mdate == `d')
 51.                 gen double tu_`d'           = treatment * urban * (mdate == `d')
 52.                 gen double tfu_`d'          = treatment * formal * urban * (mdate == `d')
 53. 
.                 local rhs "`rhs' formal_`d' urban_`d' formalurban_`d' tr_`d' tf_`d' tu_`d' tfu_`d'"
 54.                 if `d' > `base' {
 55.                     local post_tr  "`post_tr' tr_`d'"
 56.                     local post_tf  "`post_tf' tf_`d'"
 57.                     local post_tu  "`post_tu' tu_`d'"
 58.                     local post_tfu "`post_tfu' tfu_`d'"
 59.                 }
 60.             }
 61.         }
 62.     }
 63.     else {
 64.         di as error "Unknown model: `model'"
 65.         exit 198
 66.     }
 67. 
.     quietly regress y `rhs', vce(cluster code)
 68.     local N = e(N)
 69. 
.     * Save N/coverage/specification in globals for table writing.
.     global N_`col' `N'
 70.     global coverage_`col' "`coverage'"
 71.     global spec_`col' "Post"
 72. 
.     * Inner helper to compute the simple average of a list of post coefficients.
.     foreach rowcode in T TF TU TFU {
 73.         if "`rowcode'" == "T"   local terms "`post_tr'"
 74.         if "`rowcode'" == "TF"  local terms "`post_tf'"
 75.         if "`rowcode'" == "TU"  local terms "`post_tu'"
 76.         if "`rowcode'" == "TFU" local terms "`post_tfu'"
 77. 
.         if "`terms'" != "" {
 78.             local nterms : word count `terms'
 79.             local expr ""
 80.             foreach v of local terms {
 81.                 if "`expr'" == "" local expr "`v'"
 82.                 else local expr "`expr' + `v'"
 83.             }
 84.             quietly lincom (`expr') / `nterms'
 85.             local b = r(estimate)
 86.             local se = r(se)
 87.             local tstat = abs(`b' / `se')
 88.             local star ""
 89.             if `tstat' >= invnormal(0.995) local star "***"
 90.             else if `tstat' >= invnormal(0.975) local star "**"
 91.             else if `tstat' >= invnormal(0.95) local star "*"
 92. 
.             local bf : display %4.1f `b'
 93.             local sf : display %4.1f `se'
 94.             local bf = trim("`bf'")
 95.             local sf = trim("`sf'")
 96. 
.             global b_`rowcode'_`col'  "`bf'`star'"
 97.             global se_`rowcode'_`col' "(`sf')"
 98.             global rawb_`rowcode'_`col' = `b'
 99.             global rawse_`rowcode'_`col' = `se'
100.         }
101.     }
102. 
.     restore
103. end

. 
. *------------------------------*
. * Initialize blank cells       *
. *------------------------------*
. foreach r in T TF TU TFU {
  2.     forvalues c = 1/5 {
  3.         global b_`r'_`c'  "—"
  4.         global se_`r'_`c' ""
  5.         global rawb_`r'_`c'  .
  6.         global rawse_`r'_`c' .
  7.     }
  8. }

. 
. *------------------------------*
. * Run the five specifications  *
