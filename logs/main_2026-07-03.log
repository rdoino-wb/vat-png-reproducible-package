>         yline(-0.091, lpattern(dash) lcolor(gs6)) ///
>         caption("Price effect (p.p.)", pos(11)) ///
>         xtitle("") ytitle("") ///
>         ylabel(-0.3 "-30" -0.2 "-20" -0.1 "-10" 0 "0" 0.1 "10", nogrid) yscale(range(-0.2 0.2)) ///
