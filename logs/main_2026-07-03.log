(1 real change made)

. replace district_norm = "WOSERA GAWI" if district_norm == "WOSERA-GAWI"
(1 real change made)

. replace district_norm = "YANGORU SAUSSIA" if district_norm == "YANGORO-SAUSSIA" 
(1 real change made)

. 
