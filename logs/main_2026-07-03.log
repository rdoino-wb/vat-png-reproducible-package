. /*==============================================================================
>   3. T-TESTS AND SUMMARY TABLE
> ==============================================================================*/
. 
. tempname memhold

. tempfile results_file

. postfile `memhold' str20 characteristic str12 outcome ///
>     mean_yes n_yes mean_no n_no diff pval str4 sig ///
>     ci_yes ci_no ///
>     using `results_file', replace
(file /var/folders/0f/3kj03fg14mv73c8syxhy8ykm0000gp/T//S_88812.000001 not found)

. 
. local chars    "has_tax_incidence has_dev_econ has_IO has_country_exp high_confidence is_senior"

. local charlabs `" "Tax Incidence" "Dev Econ" "IO" "Country exp" "High confidence" "Senior (Prof)" "'

. 
. local outcomes_pt    "prices_1 prices_3 hetero_pass_1 hetero_pass_3"

. local outcomes_inc   "income_1 income_2 income_3 income_4 income_5"

. local outcomes       "`outcomes_pt' `outcomes_inc'"

. local outlabs  `" "PT Phone" "PT Census" "PT Chain" "PT Informal" "Q1" "Q2" "Q3" "Q4" "Q5" "'

. 
. local c = 0

. foreach char of local chars {
  2.     local ++c
  3.     local clab : word `c' of `charlabs'
  4. 
.     local o = 0
  5.     foreach out of local outcomes {
  6.         local ++o
  7.         local olab : word `o' of `outlabs'
  8. 
.         * Group means and SEs
.         qui sum `out' if `char' == 1
  9.         local m1 = r(mean)
 10.         local n1 = r(N)
 11.         local se1 = r(sd) / sqrt(r(N))
 12.         local ci1 = 1.96 * `se1'
 13. 
.         qui sum `out' if `char' == 0
 14.         local m0 = r(mean)
 15.         local n0 = r(N)
 16.         local se0 = r(sd) / sqrt(r(N))
 17.         local ci0 = 1.96 * `se0'
 18. 
.         local d = `m1' - `m0'
 19. 
.         * Welch t-test
.         capture ttest `out', by(`char') unequal
 20.         if _rc == 0 {
 21.             local p = r(p)
 22.         }
 23.         else {
 24.             local p = 1
 25.         }
 26. 
.         * Significance stars
.         local s = ""
 27.         if `p' < 0.10 local s = "*"
 28.         if `p' < 0.05 local s = "**"
 29.         if `p' < 0.01 local s = "***"
 30. 
.         post `memhold' ("`clab'") ("`olab'") ///
>             (`m1') (`n1') (`m0') (`n0') (`d') (`p') ("`s'") ///
>             (`ci1') (`ci0')
 31.     }
 32. }

. postclose `memhold'

. 
. * Display significant differences
. preserve

. use `results_file', clear

. format mean_yes mean_no diff %6.1f

. format pval %7.3f

. format ci_yes ci_no %6.1f

. list if sig != "", noobs separator(0)

  +-------------------------------------------------------------------------------------------------------+
  | characteris~c       outcome   mean_yes   n_yes   mean_no   n_no   diff    pval   sig   ci_yes   ci_no |
  |-------------------------------------------------------------------------------------------------------|
  | Tax Incidence   PT Informal       39.8      40      30.1     89    9.7   0.073     *      9.3     4.6 |
  |      Dev Econ            Q1       20.4      76      26.0     53   -5.6   0.044    **      3.1     4.3 |
  |            IO            Q4       12.8      19      18.1    110   -5.3   0.031    **      4.2     1.6 |
  |   Country exp            Q2       19.2      76      21.9     53   -2.7   0.092     *      2.0     2.4 |
  |   Country exp            Q5       20.8      76      15.9     53    4.9   0.083     *      3.6     4.1 |
  | Senior (Prof)            Q3       18.7      11      21.0    118   -2.3   0.067     *      1.8     1.5 |
  +-------------------------------------------------------------------------------------------------------+

. di _n "=== All significant differences (p < 0.10) listed above ==="

